# Copy to .env and fill in. Never commit .env.
PORT=8787
DB_PATH=./data/portal.db
# Leave unset to have a token generated and printed once on first boot.
# ADMIN_TOKEN=sk_your_fixed_admin_token
PUBLIC_SKILL_ACCESS=false

# Optional: any OpenAI-compatible endpoint powers the AI desk (Ollama works)
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=llama3.1

# Optional: raises GitHub API limits and enables private repo import
# GITHUB_TOKEN=ghp_xxx
